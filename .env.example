# ==============================================================================
# 《数证 Audit》环境变量模板（复制为 .env 后填入真实密钥，严禁提交 .env）
# ==============================================================================

# 运行模式：默认开启离线 Mock，跑通全量测试无需任何真实 API Key
MOCK_MODE=true

# 单任务预算上限（人民币元）。在线消融的所有 case 和模型共用此上限。
MAX_TASK_BUDGET_CNY=1.0

# 可选独立终裁模型开关（默认关闭，遵守三权分立与成本控制）
FINAL_JUDGE_ENABLED=false

# 主力模型 1：DeepSeek（初审 primary_reviewer）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 主力模型 2：火山引擎豆包（反方 challenger）
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# 备用降级模型：Qwen（当主力超时/故障时诚实降级）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 可选独立终裁模型（仅在 FINAL_JUDGE_ENABLED=true 且满足门控时最多调用 1 次）
PREMIUM_API_KEY=your_premium_api_key_here
PREMIUM_BASE_URL=https://api.openai.com/v1
PREMIUM_MODEL=gpt-4o
